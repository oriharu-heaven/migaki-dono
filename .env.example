# 深掘りパート（§7.3）の質問生成に使う。
# クライアントには絶対に置かないこと。/api/generate の中だけで使う。
#
# キーは https://aistudio.google.com/apikey で取得する（無料枠あり）。
GEMINI_API_KEY=AIza...

# 任意。未設定なら gemini-3.5-flash-lite を使う。
# §7.6 のフォールバックが3秒で発火するので、速いモデルを選ぶこと。
# GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic を使う場合はこちら（GEMINI_API_KEY が無いときだけ使われる）
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
